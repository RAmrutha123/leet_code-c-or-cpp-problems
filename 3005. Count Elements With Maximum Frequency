class Solution {
public:
    int maxFrequencyElements(vector<int>& nums) {
        unordered_map<int,int> freq;
        for(auto a:nums){
            freq[a]++;
        }
        int maxi=0;
        for(auto x:freq){
            maxi=max(maxi,x.second);
        }
        int ans=0;
        for(auto x:freq){
            if(x.second==maxi)
              ans+=x.second;
        }
        return ans;
    }
};
