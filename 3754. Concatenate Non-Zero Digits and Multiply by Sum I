class Solution {
public:
    long long sumAndMultiply(int n) {
        string s=to_string(n);
        long long sum=0;
        long long x=0;
        for(char ch:s){
            if(ch!='0'){
                int d=ch-'0';
                x=x*10+d;
                sum+=d;
            }
        }
        return x*sum;
    }
};
