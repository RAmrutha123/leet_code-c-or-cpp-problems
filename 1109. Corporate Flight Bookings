class Solution {
public:
    vector<int> corpFlightBookings(vector<vector<int>>& bookings, int n) {
        vector<int> ans(n, 0);
 int m = bookings.size();
 // O(M)
 for(int i = 0; i < m; i++) {
 int first = bookings[i][0], last = bookings[i][1], seats = bookings[i][2];
 ans[first-1] += seats;
 if(last != n) {
 ans[last] -= seats;
 }
 }
 // O(N)
 for(int i = 1; i < n; i++) {
 ans[i] = ans[i]+ans[i-1];
 }
 return ans;
    }
};
